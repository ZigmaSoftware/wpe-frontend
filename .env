# Set true for production. Production overrides VITE_ENV.
VITE_PROD=false

# When VITE_PROD=false, set VITE_ENV to: local | server
# local  → same machine as backend (127.0.0.1)
# server → LAN server (192.168.5.19)
VITE_ENV=server

# ── Local (developer machine) ─────────────────────────────
VITE_CORE_API_LOCAL=http://127.0.0.1:8000
VITE_GRN_API_LOCAL=http://127.0.0.1:8002

# ── LAN Server ────────────────────────────────────────────
VITE_CORE_API_SERVER=http://192.168.5.19:8000
VITE_GRN_API_SERVER=http://192.168.5.19:8002

# ── Production ────────────────────────────────────────────
VITE_CORE_API_PROD=http://115.245.93.26:7904
VITE_GRN_API_PROD=http://115.245.93.26:7904
 
FRONTEND_LIVE_URL=http://115.245.93.26:8973
PHP_MYADMIN=192.168.1.128/phpmyadmin

# WebSocket endpoints (protocol changes with HTTP→WS)
VITE_BACKEND_WS_PROD=ws://115.245.93.26:7904
VITE_BACKEND_WS_SERVER=ws://192.168.5.19:8000
VITE_BACKEND_WS_LOCAL=ws://127.0.0.1:8000
